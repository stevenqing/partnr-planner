# SSH配置文件
# 用于连接到partnr-planner服务器

Host partnr-planner
    HostName 10.211.114.57
    User shuqing
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ForwardAgent yes
    ForwardX11 no
    Compression yes

# 备用配置（使用内网IP）
Host partnr-planner-local
    HostName 172.18.0.1
    User shuqing
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ForwardAgent yes
    ForwardX11 no
    Compression yes
